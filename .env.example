# ==============================================================================
# RailScope - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# Database Configuration (TimescaleDB / PostgreSQL)
POSTGRES_USER=rail_admin
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=railscope

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

